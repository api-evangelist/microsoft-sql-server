  "info": {
    "_postman_id": "0223d3d9-6913-4e91-b552-6d7e7af6e70f",
    "name": "Microsoft SQL Server - Azure SQL & Data API Builder HTTP APIs Azure SQL Databases API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "A consolidated view of the HTTP-accessible APIs in the Microsoft SQL Server ecosystem. This document covers (1) the Azure Resource Manager REST API for managing Azure SQL Database resources and (2) the Data API Builder (DAB) runtime that exposes REST endpoints over SQL Server, Azure SQL, PostgreSQL, MySQL, and Azure Cosmos DB. Native SQL Server drivers (ODBC, JDBC, SqlClient, OLE DB, tedious, mssql-python) are not HTTP APIs and are not represented here.",
      "type": "text/plain"
    }
  }
