            "url": "https://management.azure.com/api/:entity/:pkColumn/:pkValue",
            "params": [
              {
                "name": "entity",
                "value": "",
                "type": "path",
                "description": "Name of the entity exposed by Data API Builder."
              },
              {
                "name": "pkColumn",
                "value": "",
