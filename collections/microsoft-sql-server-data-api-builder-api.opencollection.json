            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://management.azure.com/api/:entity",
            "params": [
              {
                "name": "entity",
                "value": "",
                "type": "path",
                "description": "Name of the entity exposed by Data API Builder."
              },
              {
                "name": "$select",
                "value": "",
                "type": "query"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query"
              },
